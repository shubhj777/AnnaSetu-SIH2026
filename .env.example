# ==============================================================================
# AnnaSetu (KisanQueue) Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides. DO NOT commit real secrets or API keys.
# On Render, configure these in Dashboard -> Service -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. SERVER NETWORK BINDING
# ------------------------------------------------------------------------------
# In production on Render, PORT is automatically injected by the platform (e.g. 10000).
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# HMAC-SHA256 session token signing secret key.
# In production on Render, set this to a strong 64-character random string or use
# Render's automatic secret generator.
SECRET_KEY=kisanqueue-secure-token-secret-key-2026-prod

# ------------------------------------------------------------------------------
# 3. DATABASE PERSISTENCE (SQLite Engine)
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_PATH=kisanqueue.db

# Production on Render with Persistent Disk mounted at /data:
# DATABASE_PATH=/data/kisanqueue.db

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Leave blank to use defaults (local dev ports + automatic *.onrender.com support).
# In production with a custom domain, set:
# ALLOWED_ORIGINS=https://annasetu.onrender.com,https://yourcustomdomain.gov.in
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 5. SMS NOTIFICATION GATEWAYS (Optional)
# ------------------------------------------------------------------------------
# SMS dispatch mode: demo | fast2sms | twilio | msg91 | custom_http
SMS_MODE=demo
SMS_SENDER_ID=KISANQ

# Provider specific credentials (required only if SMS_MODE != demo):
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_FROM_NUMBER=+1234567890
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_FLOW_ID=your_msg91_flow_id_here
# MSG91_SENDER_ID=ANNAST
